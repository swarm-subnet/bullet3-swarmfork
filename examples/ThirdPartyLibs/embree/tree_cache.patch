+  RTC_API size_t rtcSwarmSaveTree(RTCScene hscene, void* buffer, size_t capacity)
+  {
+    Scene* scene = (Scene*) hscene;
+    RTC_CATCH_BEGIN;
+    RTC_TRACE(rtcSwarmSaveTree);
+    RTC_VERIFY_HANDLE(hscene);
+    if (scene->isModified()) throw_RTCError(RTC_ERROR_INVALID_OPERATION,"scene not committed");
+    const std::vector<char> image = swarmSaveTree(scene);
+    if (buffer && capacity >= image.size() && !image.empty())
+      memcpy(buffer, &image[0], image.size());
+    return image.size();
+    RTC_CATCH_END2(scene);
+    return 0;
+  }
+
+  RTC_API void rtcSwarmLoadTree(RTCScene hscene, const void* buffer, size_t bytes)
+  {
+    Scene* scene = (Scene*) hscene;
+    RTC_CATCH_BEGIN;
+    RTC_TRACE(rtcSwarmLoadTree);
+    RTC_VERIFY_HANDLE(hscene);
+    if (buffer && bytes)
+      scene->swarm_tree.assign((const char*) buffer, (const char*) buffer + bytes);
+    else
+      scene->swarm_tree.clear();
+    RTC_CATCH_END2(scene);
+  }
